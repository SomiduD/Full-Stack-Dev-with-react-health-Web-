# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/healthcare
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/healthcare
MONGO_URI=mongodb://localhost:27017/healthcare

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed front-end URL in production
CLIENT_ORIGIN=http://localhost:5173
