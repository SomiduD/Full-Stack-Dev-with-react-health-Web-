              "raw": "{\n    \"isActive\": false\n}"
            },
            "url": "{{base}}/api/admin/doctors/{{doctorId}}/status"
          },
          "response": []
        },
        {
          "name": "All Appointments (Hospital)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/admin/appointments"
          },
          "response": []
        },
        {
          "name": "All Patients (Hospital)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/admin/patients"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Super Admin",
      "item": [
        {
          "name": "Platform-wide Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/superadmin/stats"
          },
          "response": []
        },
        {
          "name": "List All Hospitals",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/superadmin/hospitals"
          },
          "response": []
        },
        {
          "name": "Toggle Hospital Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"isActive\": true\n}"
            },
            "url": "{{base}}/api/superadmin/hospitals/{{hospitalId}}/status"
          },
          "response": []
        },
        {
          "name": "Pending Verifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/superadmin/verifications?status=pending",
              "host": ["{{base}}"],
              "path": ["api", "superadmin", "verifications"],
              "query": [
                { "key": "status", "value": "pending" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve User",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{base}}/api/superadmin/verifications/PASTE_USER_ID_HERE/approve"
          },
          "response": []
        },
        {
          "name": "Reject User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Identity document unclear — please resubmit.\"\n}"
            },
            "url": "{{base}}/api/superadmin/verifications/PASTE_USER_ID_HERE/reject"
          },
          "response": []
        }
      ]
    }

  ]
}
