            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"drsmith@demo.com\",\n    \"password\": \"DrSmith@123\",\n    \"profile\": {\n        \"firstName\": \"John\",\n        \"lastName\": \"Smith\",\n        \"specialization\": \"Cardiology\",\n        \"department\": \"Cardiac ICU\",\n        \"licenseNumber\": \"MCI-2021-00456\",\n        \"yearsExperience\": 12\n    }\n}"
            },
