{
  "info": {
    "_postman_id": "medcore-healthcare-api-v2",
    "name": "MedCore Healthcare API",
    "description": "MedCore Healthcare Platform — Complete API Collection\n\nSetup:\n1. Select 'MedCore Local' environment (top right)\n2. Run 'Login — Doctor' first → token auto-saved\n3. All other requests use the token automatically\n\nDemo Credentials:\n- Patient: patient@demo.com / Patient@12345\n- Doctor:  doctor@demo.com  / Doctor@12345\n- Admin:   admin@demo.com   / Admin@12345",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base",          "value": "http://localhost:5001",  "type": "string" },
    { "key": "accessToken",   "value": "",                        "type": "string" },
    { "key": "refreshToken",  "value": "",                        "type": "string" },
    { "key": "doctorId",      "value": "",                        "type": "string" },
    { "key": "patientId",     "value": "",                        "type": "string" },
    { "key": "appointmentId", "value": "",                        "type": "string" },
    { "key": "recordId",      "value": "",                        "type": "string" },
    { "key": "hospitalId",    "value": "",                        "type": "string" }
  ],
  "item": [

    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/health"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login — Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data) {",
                  "    pm.collectionVariables.set('accessToken',  json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    pm.collectionVariables.set('doctorId',     json.data.user.id);",
                  "    pm.collectionVariables.set('hospitalId',   json.data.user.hospitalId || '');",
                  "    console.log('Doctor token saved. ID: ' + json.data.user.id);",
                  "} else {",
                  "    console.log('Login failed: ' + JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"doctor@demo.com\",\n    \"password\": \"Doctor@12345\"\n}"
            },
            "url": "{{base}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Login — Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data) {",
                  "    pm.collectionVariables.set('accessToken',  json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    pm.collectionVariables.set('patientId',    json.data.user.id);",
                  "    pm.collectionVariables.set('hospitalId',   json.data.user.hospitalId || '');",
                  "    console.log('Patient token saved. ID: ' + json.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"patient@demo.com\",\n    \"password\": \"Patient@12345\"\n}"
            },
            "url": "{{base}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Login — Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data) {",
                  "    pm.collectionVariables.set('accessToken',  json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    console.log('Super Admin token saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@demo.com\",\n    \"password\": \"Admin@12345\"\n}"
            },
            "url": "{{base}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Register — New Patient",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"newpatient@example.com\",\n    \"password\": \"SecurePass@123\",\n    \"role\": \"patient\",\n    \"hospitalCode\": \"DEMO\",\n    \"profile\": {\n        \"firstName\": \"Jane\",\n        \"lastName\": \"Doe\",\n        \"phone\": \"+91-9000000099\",\n        \"bloodGroup\": \"A+\"\n    }\n}"
            },
            "url": "{{base}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/auth/me"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{base}}/api/auth/refresh"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{base}}/api/auth/logout"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Appointments",
      "item": [
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/appointments/slots?doctorId={{doctorId}}&date=2026-09-20",
              "host": ["{{base}}"],
              "path": ["api", "appointments", "slots"],
              "query": [
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "date",     "value": "2026-09-20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Book Appointment (Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data) {",
                  "    pm.collectionVariables.set('appointmentId', json.data._id);",
                  "    console.log('Appointment booked. ID: ' + json.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"doctorId\": \"{{doctorId}}\",\n    \"date\": \"2026-09-20\",\n    \"timeSlot\": \"09:00\",\n    \"reason\": \"Fever and headache for 3 days\"\n}"
            },
            "url": "{{base}}/api/appointments"
          },
          "response": []
        },
        {
          "name": "My Appointments (Patient)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/appointments/my"
          },
          "response": []
        },
        {
          "name": "Doctor Queue (Today)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/appointments/doctor/queue"
          },
          "response": []
        },
        {
          "name": "Doctor Schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/appointments/doctor/schedule"
          },
          "response": []
        },
        {
          "name": "Update Status — Confirm (Doctor)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"confirmed\",\n    \"doctorNotes\": \"Please bring previous prescriptions.\",\n    \"version\": 0\n}"
            },
            "url": "{{base}}/api/appointments/{{appointmentId}}/status"
          },
          "response": []
        },
        {
          "name": "Update Status — Complete (Doctor)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"completed\",\n    \"doctorNotes\": \"Patient treated. Follow-up in 2 weeks.\",\n    \"version\": 1\n}"
            },
            "url": "{{base}}/api/appointments/{{appointmentId}}/status"
          },
          "response": []
        },
        {
          "name": "Cancel Appointment (Patient)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"cancelled\",\n    \"cancelledReason\": \"Personal emergency\",\n    \"version\": 0\n}"
            },
            "url": "{{base}}/api/appointments/{{appointmentId}}/status"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Health Records",
      "item": [
        {
          "name": "Get Health Records",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/health-records"
          },
          "response": []
        },
        {
          "name": "Create Health Record (Doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data) {",
                  "    pm.collectionVariables.set('recordId', json.data._id);",
                  "    console.log('Record created. ID: ' + json.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"patientId\": \"{{patientId}}\",\n    \"type\": \"lab\",\n    \"title\": \"Complete Blood Count\",\n    \"description\": \"Routine CBC — all values within normal range\",\n    \"fileUrl\": \"https://storage.example.com/reports/cbc.pdf\",\n    \"date\": \"2026-09-09\"\n}"
            },
            "url": "{{base}}/api/health-records"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Doctors",
      "item": [
        {
          "name": "List Doctors in Hospital",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data && json.data.length > 0) {",
                  "    var id = json.data[0]._id || json.data[0].id;",
                  "    pm.collectionVariables.set('doctorId', id);",
                  "    console.log('doctorId set: ' + id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/doctors"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Ambulance",
      "item": [
        {
          "name": "Request Ambulance (Patient)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"locationNote\": \"Near Main Gate, Building A, 2nd Floor\",\n    \"emergencyType\": \"cardiac\",\n    \"notes\": \"Patient experiencing chest pain and difficulty breathing\"\n}"
            },
            "url": "{{base}}/api/ambulance/request"
          },
          "response": []
        },
        {
          "name": "My Ambulance Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/ambulance/my-requests"
          },
          "response": []
        }
      ]
    },

    {
      "name": "Admin (Hospital)",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/admin/stats"
          },
          "response": []
        },
        {
          "name": "Get Hospital Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/admin/hospital"
          },
          "response": []
        },
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/api/admin/doctors"
          },
          "response": []
        },
        {
          "name": "Create Doctor Account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
